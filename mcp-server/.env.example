# Ключ API: https://www.kimi.com/code/console (подписка Kimi Code)
MOONSHOT_API_KEY=

# База данных
DATABASE_URL=postgres://postgres:postgres@localhost:5433/qlik_table

# Endpoint и модель Kimi Code (подписка).
# Для платформы Moonshot (pay-as-you-go) вместо этого:
#   MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
#   MOONSHOT_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.kimi.ai/coding/v1
MOONSHOT_MODEL=kimi-for-coding

# Температура генерации (0 — минимальный разброс; coding-endpoint Kimi допускает
# только 1 — сервер сам повторит вызов с temperature=1, если endpoint отклонил 0).
# Окончательную детерминированность повторных вопросов даёт кэш NL2SQL_CACHE.
MOONSHOT_TEMPERATURE=0

# Seed генерации (детерминированность сэмплирования там, где endpoint его поддерживает)
MOONSHOT_SEED=42

# Максимум строк в ответе execute_sql
MAX_ROWS=1000

# Трассировка nl_to_sql: полный лог пути «вопрос -> промпт -> LLM -> разбор -> валидация -> ответ».
# Пусто/не задана — трассировка выключена. Относительный путь — от cwd сервера.
# NL2SQL_TRACE=logs/nl2sql-trace.log

# Кэш «вопрос -> SQL»: одинаковые вопросы не гоняют LLM повторно. По умолчанию
# mcp-server/nl2sql-cache.json; NL2SQL_CACHE=0 — выключить.
# NL2SQL_CACHE=0

# Few-shot примеры в промпте nl_to_sql: вопросы и эталонные SQL из eval/questions.json
# подмешиваются в системный промпт. NL2SQL_EXAMPLES=0 — выключить (например, для чистого eval).
# NL2SQL_EXAMPLES=0

